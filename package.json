{
  "name": "cloudpaste-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for securely uploading, sharing, listing, inspecting, and deleting CloudPaste files.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "cloudpaste-mcp-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/**/*.test.ts",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cloudpaste",
    "file-sharing",
    "webdav"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "mime-types": "^3.0.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.18.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
