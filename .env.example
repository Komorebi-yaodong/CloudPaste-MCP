# Required CloudPaste server URL, without a trailing slash.
CLOUDPASTE_URL=https://copy.example.com

# Dedicated CloudPaste API key with FILE_SHARE + FILE_MANAGE permissions (value: 10).
CLOUDPASTE_API_KEY=replace-with-your-api-key

# Optional defaults.
CLOUDPASTE_DEFAULT_PATH=/CloudPaste/MCP
CLOUDPASTE_STORAGE_CONFIG_ID=
CLOUDPASTE_DEFAULT_EXPIRES_HOURS=24
